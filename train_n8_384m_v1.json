{
  "name": "n8_s128",
  "model": {
    "seq_len": 128,
    "activation": "silu",
    "normalization": "batchnorm",
    "init_gain": 1.0,
    "dropout": 0.0,
    "norm_bottleneck": false,
    "norm_last": false
  },
  "training": {
    "target_samples": 150000000,
    "batch_size": 256,
    "lr": 0.00025,
    "grad_clip": 1.0,
    "scheduler": "plateau",
    "warmup_fraction": 0.01,
    "plateau_patience": 5,
    "optimizer": "adamw_fused",
    "weight_decay": 0.01,
    "early_stop_patience": 999,
    "train_ratio": 0.999,
    "num_workers": 2
  },
  "sweep": {
    "strategy": "grid",
    "vary": "n",
    "values": [8],
    "solve": "b",
    "budget": 384000000
  },
  "output": {
    "workspace": "sessions/train",
    "device": "auto"
  }
}
