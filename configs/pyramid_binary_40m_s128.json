{
  "name": "pyramid_binary_40m_s128",
  "model": {
    "seq_len": 128,
    "bottleneck": null,
    "activation": "silu",
    "normalization": "batchnorm",
    "init": "orthogonal",
    "init_gain": 0.5,
    "dropout": 0.0,
    "shape": "pyramid"
  },
  "training": {
    "target_samples": 120000000,
    "lr": 0.001,
    "grad_clip": 1.0,
    "scheduler": "cosine",
    "warmup_fraction": 0.05,
    "optimizer": "adamw_fused",
    "weight_decay": 0.01,
    "early_stop_patience": 3,
    "train_ratio": 0.99
  },
  "sweep": {
    "strategy": "binary",
    "vary": "n",
    "values": [2, 16],
    "solve": "b",
    "budget": 40000000,
    "fixed": {}
  },
  "output": {
    "workspace": "sessions/pyramid_binary",
    "sweep_log": "sessions/pyramid_binary_40m_s128_summary.csv",
    "device": "auto",
    "batch_size": 256
  }
}
