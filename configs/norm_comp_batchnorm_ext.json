{
  "name": "norm_comp_batchnorm_ext",
  "model": {
    "seq_len": 32,
    "bottleneck": 32,
    "activation": "silu",
    "normalization": "batchnorm",
    "init": "orthogonal",
    "init_gain": 0.5,
    "dropout": 0.0
  },
  "training": {
    "target_samples": 120000000,
    "lr": 0.001,
    "grad_clip": 1.0,
    "scheduler": "cosine",
    "warmup_fraction": 0.05,
    "optimizer": "adamw_fused",
    "weight_decay": 0.01,
    "early_stop_patience": 3,
    "train_ratio": 0.99
  },
  "sweep": {
    "strategy": "grid",
    "vary": "batch_size",
    "values": [512, 1024],
    "solve": "b",
    "budget": 40000000,
    "fixed": {"n": 5}
  },
  "output": {
    "workspace": "sessions/norm_comp",
    "sweep_log": "sessions/norm_comp_batchnorm_ext.csv",
    "device": "auto",
    "batch_size": null
  }
}
