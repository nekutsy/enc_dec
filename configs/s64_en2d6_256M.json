{
  "model": {
    "seq_len": 64,
    "bottleneck": 64,
    "enc_n": 2,
    "dec_n": 6,
    "activation": "silu",
    "normalization": "rmsnorm",
    "shape": "rectangular",
    "init_gain": 1.0,
    "dropout": 0.0,
    "norm_bottleneck": false,
    "norm_last": false,
    "residual": true,
    "residual_norm": "pre"
  },
  "training": {
    "target_samples": 70000000,
    "batch_size": 256,
    "lr": 0.0001,
    "grad_clip": 1.0,
    "scheduler": "greedy_simple",
    "warmup_fraction": 0.02,
    "greedy_simple_min_lr": 1e-6,
    "greedy_simple_max_lr": 0.01,
    "greedy_simple_inc": 1.01,
    "greedy_simple_dec": 0.75,
    "greedy_simple_patience": 1000,
    "greedy_simple_warmup": 2000,
    "optimizer": "adamw_fused",
    "weight_decay": 0.01,
    "decay_linear_only": true,
    "use_tf32": true,
    "noise_prob": 0.1,
    "noise_std": 3.0,
    "early_stop_patience": 20,
    "train_ratio": 0.999,
    "val_interval": 500000,
    "checkpoint_interval": 5000000,
    "num_workers": 2
  },
  "sweep": {
    "strategy": "grid",
    "vary": "enc_n",
    "values": [2],
    "solve": "b",
    "budget": 256000000
  },
  "output": {
    "device": "auto"
  }
}
