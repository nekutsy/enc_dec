{
  "name": "bottleneck_sweep_4M",
  "model": {
    "seq_len": 128,
    "bottleneck": null,
    "activation": "silu",
    "normalization": "batchnorm",
    "init_gain": 1.0,
    "dropout": 0.001,
    "norm_bottleneck": false,
    "norm_last": false
  },
  "training": {
    "target_samples": 4000000,
    "batch_size": 256,
    "lr": 0.0001,
    "grad_clip": 1.0,
    "scheduler": "greedy_simple",
    "warmup_fraction": 0.02,
    "optimizer": "lion",
    "weight_decay": 0.01,
    "decay_linear_only": true,
    "early_stop_patience": 20,
    "train_ratio": 0.999,
    "num_workers": 2,
    "greedy_simple_warmup": 1954,
    "greedy_simple_min_lr": 1e-6,
    "greedy_simple_max_lr": 0.4,
    "greedy_simple_inc": 1.01,
    "greedy_simple_dec": 0.75,
    "greedy_simple_patience": 500
  },
  "sweep": {
    "strategy": "grid",
    "vary": "bottleneck",
    "values": [64, 96, 128, 160, 192, 224],
    "solve": "b",
    "budget": 384000000,
    "fixed": {
      "n": 6
    }
  },
  "output": {
    "workspace": "sessions/bottleneck_sweep",
    "sweep_log": "sessions/bottleneck_sweep_summary.csv",
    "device": "auto"
  }
}
