{
  "name": "noise_sweep_compare_4M",
  "model": {
    "seq_len": 64,
    "bottleneck": 64,
    "activation": "silu",
    "normalization": "rmsnorm",
    "shape": "rectangular",
    "enc_n": 2,
    "dec_n": 6,
    "dropout": 0.0,
    "residual": true,
    "residual_norm": "pre"
  },
  "training": {
    "target_samples": 4000000,
    "batch_size": 256,
    "lr": 0.0001,
    "grad_clip": 1.0,
    "scheduler": "greedy_simple",
    "optimizer": "adamw_fused",
    "weight_decay": 0.01,
    "decay_linear_only": true,
    "greedy_simple_patience": 1000,
    "greedy_simple_warmup": 2000,
    "greedy_simple_min_lr": 1e-6,
    "greedy_simple_max_lr": 0.01,
    "noise_std_min": 3.0,
    "noise_std_max": 3.0,
    "val_interval": 500000,
    "num_workers": 2
  },
  "sweep": {
    "strategy": "grid",
    "vary": "noise_prob_min",
    "values": [0.0, 0.25, 0.5, [0.0, 0.5]],
    "solve": null,
    "budget": null,
    "fixed": {
      "enc_n": 2,
      "dec_n": 6,
      "b": 4.688
    }
  },
  "output": {
    "workspace": "sessions/noise_sweep_compare_4M",
    "sweep_log": "sessions/noise_sweep_compare_4M_summary.csv",
    "device": "auto"
  }
}
