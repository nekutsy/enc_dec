{
  "name": "ratio_40m",
  "model": {
    "seq_len": 32,
    "bottleneck": null,
    "activation": "silu",
    "normalization": "batchnorm",
    "init": "orthogonal",
    "init_gain": 0.5,
    "dropout": 0.0
  },
  "training": {
    "target_samples": 120000000,
    "lr": 0.001,
    "grad_clip": 1.0,
    "scheduler": "cosine",
    "warmup_fraction": 0.05,
    "optimizer": "adamw_fused",
    "weight_decay": 0.01,
    "early_stop_patience": 3,
    "train_ratio": 0.99
  },
  "sweep": {
    "strategy": "grid",
    "vary": "n",
    "values": [
      2,
      4,
      6,
      8,
      10
    ],
    "solve": "b",
    "budget": 40000000,
    "fixed": {}
  },
  "output": {
    "workspace": "sessions/ratio40",
    "sweep_log": "sessions/ratio40_sweep_summary.csv",
    "device": "auto",
    "batch_size": null
  }
}