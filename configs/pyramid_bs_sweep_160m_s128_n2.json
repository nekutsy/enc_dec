{
  "name": "pyramid_bs_sweep_160m_s128_n2",
  "model": {
    "seq_len": 128,
    "bottleneck": null,
    "activation": "silu",
    "normalization": "batchnorm",
    "init": "orthogonal",
    "init_gain": 0.5,
    "dropout": 0.0,
    "shape": "pyramid"
  },
  "training": {
    "target_samples": 2000000,
    "lr": 0.001,
    "grad_clip": 1.0,
    "scheduler": "cosine",
    "warmup_fraction": 0.05,
    "optimizer": "adamw_fused",
    "weight_decay": 0.01,
    "early_stop_patience": 3,
    "train_ratio": 0.99
  },
  "sweep": {
    "strategy": "grid",
    "vary": "batch_size",
    "values": [128, 256, 512, 1024],
    "solve": "b",
    "budget": 160000000,
    "fixed": {"n": 2}
  },
  "output": {
    "workspace": "sessions/pyramid_bs",
    "sweep_log": "sessions/pyramid_bs_160m_s128_n2_summary.csv",
    "device": "auto",
    "batch_size": null
  }
}
