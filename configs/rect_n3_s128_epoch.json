{
  "name": "rect_n3_s128_epoch_160M",
  "model": {
    "seq_len": 128,
    "bottleneck": null,
    "activation": "silu",
    "normalization": "batchnorm",
    "init": "orthogonal",
    "init_gain": 0.5,
    "dropout": 0.0,
    "shape": "rectangular"
  },
  "training": {
    "target_samples": 50000000,
    "lr": 0.001,
    "grad_clip": 1.0,
    "scheduler": "plateau",
    "warmup_fraction": 0.05,
    "optimizer": "adamw_fused",
    "weight_decay": 0.001,
    "early_stop_patience": 8,
    "train_ratio": 0.99
  },
  "sweep": {
    "strategy": "grid",
    "vary": "n",
    "values": [3],
    "solve": "b",
    "budget": 160000000,
    "fixed": {}
  },
  "output": {
    "workspace": "sessions/rect_n3_s128_epoch",
    "sweep_log": "sessions/rect_n3_s128_epoch_summary.csv",
    "device": "auto",
    "batch_size": 256
  }
}
